# ── ScheduleLink Backend Configuration ──
# Copy this to .env and fill in the blanks.
# For production (Render), set these as Environment Variables in the Render dashboard.

# ── Database ──
# Dev: sqlite:///./schedulelink.db
# Prod: postgresql://user:pass@host:5432/schedulelink?sslmode=require
DATABASE_URL=sqlite:///./schedulelink.db

# ── App Environment ──
ENVIRONMENT=development          # "development" | "production"
JWT_SECRET_KEY=change-me-to-a-32-byte-hex-secret
ENCRYPTION_KEY=                  # Leave blank for dev (derived from JWT_SECRET_KEY)

# ── Frontend ──
FRONTEND_URL=http://localhost:3000   # Dev: http://localhost:3000 — Prod: https://www.schedulelink.tech
BACKEND_URL=http://localhost:8000    # Dev: http://localhost:8000 — Prod: https://schedulelink-app.onrender.com

# ── Google OAuth — set up at https://console.cloud.google.com/apis/credentials ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback  # Prod: https://schedulelink-app.onrender.com/auth/google/callback

# ── Microsoft OAuth — set up at https://portal.azure.com/ (optional) ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback  # Prod: https://schedulelink-app.onrender.com/auth/microsoft/callback

# ── Stripe (LIVE — Otion LLC) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_1TR1Tz1Bpwy6AKFbdF1nAnud
STRIPE_PRO_PLUS_PRICE_ID=price_1TR1bi1Bpwy6AKFbPKi579t5

# ── Email (Zoho Mail) ──
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=support@schedulelink.tech
SMTP_PASSWORD=                    # REQUIRED for email notifications to work
EMAIL_FROM=ScheduleLink <support@schedulelink.tech>
